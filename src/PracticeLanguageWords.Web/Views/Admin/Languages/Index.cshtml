@model IReadOnlyList<LanguageDto>
@{
    ViewData["Title"] = "Dil Yönetimi";
    ViewBag.ActiveTab = "languages";
}

<partial name="_AdminTabs" />

<div class="page-header">
    <h1>Diller</h1>
    <a class="btn btn-primary" href="/admin/languages/create">+ Yeni Dil</a>
</div>

<p class="help-text" style="margin-bottom:1rem;">
    Seslendirme kodu, kelimenin hangi aksanla okunacağını belirler (İngilizce <code>en-US</code>,
    Almanca <code>de-DE</code>, Fransızca <code>fr-FR</code>). Kart ekranındaki ve
    "Bilmediğim Kelimeler" listesindeki 🔊 butonları bu koda göre çalışır.
</p>

@if (Model.Count == 0)
{
    <div class="empty-state">Henüz dil eklenmemiş.</div>
}
else
{
    <div class="table-wrap">
        <table class="responsive-table">
            <thead>
                <tr>
                    <th>Dil</th>
                    <th>Kod</th>
                    <th>Seslendirme</th>
                    <th>Durum</th>
                    <th>Kategori</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var language in Model)
                {
                    <tr>
                        <td data-label="Dil"><strong>@language.Name</strong></td>
                        <td data-label="Kod">@language.Code</td>
                        <td data-label="Seslendirme">
                            @language.SpeechCode
                            <button type="button" class="btn-speak"
                                    data-speak="@language.Name"
                                    data-speech-code="@language.SpeechCode"
                                    title="Örnek seslendirme">🔊</button>
                        </td>
                        <td data-label="Durum">
                            <span class="tag @(language.IsActive ? "tag-easy" : "tag-hard")">
                                @(language.IsActive ? "Aktif" : "Pasif")
                            </span>
                        </td>
                        <td data-label="Kategori">@language.CategoryCount</td>
                        <td data-label="">
                            <div class="row-actions">
                                <a class="btn btn-outline btn-sm" href="/admin/languages/@language.Id/edit">Düzenle</a>
                                <a class="btn btn-outline btn-sm" href="/admin/categories?languageId=@language.Id">Kategoriler</a>
                                <form method="post" action="/admin/languages/@language.Id/delete" class="inline-form"
                                      onsubmit="return confirm('@language.Name silinsin mi?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
