@model IReadOnlyList<CategoryAdminDto>
@{
    ViewData["Title"] = "Kategori Yönetimi";
    ViewBag.ActiveTab = "categories";
    IReadOnlyList<LanguageDto> languages = ViewBag.Languages ?? new List<LanguageDto>();
    int? selectedLanguageId = ViewBag.LanguageId;
}

<partial name="_AdminTabs" />

<div class="page-header">
    <h1>Kategoriler</h1>
    <a class="btn btn-primary" href="/admin/categories/create?languageId=@(selectedLanguageId ?? 0)">+ Yeni Kategori</a>
</div>

<form method="get" action="/admin/categories" class="toolbar">
    <select name="languageId">
        <option value="">Tüm diller</option>
        @foreach (var language in languages)
        {
            <option value="@language.Id" selected="@(selectedLanguageId == language.Id)">@language.Name</option>
        }
    </select>
    <button type="submit" class="btn btn-outline">Filtrele</button>
</form>

@if (Model.Count == 0)
{
    <div class="empty-state">Kategori bulunamadı.</div>
}
else
{
    <div class="table-wrap">
        <table class="responsive-table">
            <thead>
                <tr>
                    <th>Kategori</th>
                    <th>Dil</th>
                    <th>Grup</th>
                    <th>Kelime</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr>
                        <td data-label="Kategori"><strong>@category.Name</strong></td>
                        <td data-label="Dil">@category.LanguageName</td>
                        <td data-label="Grup">@category.CategoryGroupName</td>
                        <td data-label="Kelime">@category.WordCount</td>
                        <td data-label="">
                            <div class="row-actions">
                                <a class="btn btn-outline btn-sm" href="/admin/categories/@category.Id/edit">Düzenle</a>
                                <a class="btn btn-outline btn-sm" href="/admin/words?categoryId=@category.Id">Kelimeler</a>
                                <form method="post" action="/admin/categories/@category.Id/delete" class="inline-form"
                                      onsubmit="return confirm('@category.Name kategorisi silinsin mi?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    <p class="help-text" style="margin-top:.75rem;">
        İçinde kelime bulunan kategoriler silinemez; önce kelimeleri silin ya da başka kategoriye taşıyın.
    </p>
}
