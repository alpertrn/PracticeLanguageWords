@model IReadOnlyList<CategoryGroupDto>
@{
    ViewData["Title"] = "Kategori Grupları";
    ViewBag.ActiveTab = "groups";
}

<partial name="_AdminTabs" />

<div class="page-header">
    <h1>Kategori Grupları</h1>
    <a class="btn btn-primary" href="/admin/category-groups/create">+ Yeni Grup</a>
</div>

<p class="help-text" style="margin-bottom:1rem;">
    Gruplar kategorileri düzenlemek içindir (örn. "PracticeWords"). Dil ise kategorinin kendisinde tanımlanır.
</p>

@if (Model.Count == 0)
{
    <div class="empty-state">Henüz grup eklenmemiş.</div>
}
else
{
    <div class="table-wrap">
        <table class="responsive-table">
            <thead>
                <tr>
                    <th>Grup</th>
                    <th>Şablon</th>
                    <th>Kategori</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var group in Model)
                {
                    <tr>
                        <td data-label="Grup"><strong>@group.Name</strong></td>
                        <td data-label="Şablon">@group.UiTemplate</td>
                        <td data-label="Kategori">@group.CategoryCount</td>
                        <td data-label="">
                            <div class="row-actions">
                                <a class="btn btn-outline btn-sm" href="/admin/category-groups/@group.Id/edit">Düzenle</a>
                                <form method="post" action="/admin/category-groups/@group.Id/delete" class="inline-form"
                                      onsubmit="return confirm('@group.Name silinsin mi?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-danger btn-sm">Sil</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
